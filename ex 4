package prac;

public class ex6 {
    public static void main(String[] args) {
        String[] names = {"Ana", "Ben", "Carla", "Diego"};
        double[][] sales = {
            {18000, 20000, 15000},
            {12000, 15000, 18000},
            {10000, 12000, 14000},
            {20000, 20000, 15000} // Added sales data for Diego
        };
        
        double quota = 50000, basicsalary = 20000;
        double totalPayroll = 0;
        int quotaCount = 0;

        System.out.printf("%-7s %8s %6s %10s %9s%n", "NAME", "SALES", "QUOTA", "COMMISSION", "SALARY");

        for (int r = 0; r < sales.length; r++) {
            double totalSales = 0;
            for (int c = 0; c < sales[r].length; c++) {
                totalSales += sales[r][c];
            }

            boolean metQuota = totalSales >= quota;
            double commission = metQuota ? totalSales * 0.03 : 0;
            double salary = basicsalary + commission;

            if (metQuota) quotaCount++;
            totalPayroll += salary;

            System.out.printf("%-7s %8.0f %6s %10.0f %9.0f%n", 
                names[r], totalSales, metQuota ? "YES" : "NO", commission, salary);
        }

        System.out.println("\nQuota achievers: " + quotaCount);
        System.out.printf("Total payroll: %.0f%n", totalPayroll);
    }
}
