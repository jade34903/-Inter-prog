package jade;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;

public class W3A5Guirre {
	public static void main(String[] args) {
        try (
            FileReader reader = new FileReader("input.txt");
            FileWriter writer = new FileWriter("uppercase.txt")
        ) {
            int ch;

            while ((ch = reader.read()) != -1) {
                char letter = (char) ch;
                writer.write(Character.toUpperCase(letter));
            }

            System.out.println("Uppercase file created.");
        } catch (IOException e) {
            System.out.println("File processing error.");
        }
    }
}






package jade;

import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class W3EAGuirre {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        String fileName = "student_records.txt";
        int choice = 0;

        while (choice != 3) {
            System.out.println("\n=== STUDENT RECORD ===");
            System.out.println("1) Input new Student Record");
            System.out.println("2) View Student Records");
            System.out.println("3) Exit");
            System.out.print("Enter your choice: ");

            
            if (scanner.hasNextInt()) {
                choice = scanner.nextInt();
                scanner.nextLine(); 
            } else {
                System.out.println("Invalid input. Please enter a number (1-3).");
                scanner.nextLine();
                continue;
            }

            switch (choice) {
                case 1:
                 
                    System.out.print("Enter Student ID: ");
                    String id = scanner.nextLine();
                    System.out.print("Enter Student Name: ");
                    String name = scanner.nextLine();
                    System.out.print("Enter Course/Program: ");
                    String course = scanner.nextLine();

                
                    try (FileWriter writer = new FileWriter(fileName, true)) {
                        writer.write("ID: " + id + " | Name: " + name + " | Course: " + course + "\n");
                        System.out.println("Student record saved successfully!");
                    } catch (IOException e) {
                        System.out.println("An error occurred while saving the record: " + e.getMessage());
                    }
                    break;

                case 2:
                	
                    System.out.println("\n--- SAVED RECORDS ---");
                    File file = new File(fileName);
                    
                    if (!file.exists()) {
                        System.out.println("No records found yet. Add a student first.");
                    } else {
                        try (FileReader reader = new FileReader(file);
                             Scanner fileScanner = new Scanner(reader)) {
                            
                            while (fileScanner.hasNextLine()) {
                                System.out.println(fileScanner.nextLine());
                            }
                        } catch (IOException e) {
                            System.out.println("An error occurred while reading the file: " + e.getMessage());
                        }
                    }
                    break;

                case 3:
                    System.out.println("Exiting program. Goodbye!");
                    break;

                default:
                    System.out.println("Invalid choice. Please select 1, 2, or 3.");
            }
        }
        scanner.close();
    }
}
